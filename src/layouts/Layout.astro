---
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/700.css";
import "@fontsource/dm-sans/400-italic.css";
import "../styles/global.css";
import EnTete from "../components/EnTete.astro";
import PiedDePage from "../components/PiedDePage.astro";
import Consentement from "../components/Consentement.astro";
import { site, seo, mesure, type CleSeo } from "../data/site";

interface Props {
  page: CleSeo;
  /** Image de partage, chemin absolu depuis la racine du site. */
  image?: string;
}

const { page, image = "/favicon.png" } = Astro.props;
const { titre, description } = seo[page];
const canonique = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />

    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preload" href="/fonts/Lovelo-Black.otf" as="font" type="font/otf" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {mesure.searchConsole && <meta name="google-site-verification" content={mesure.searchConsole} />}
  </head>

  <body>
    <EnTete />
    <slot />
    <PiedDePage />
    <Consentement />

    <script>
      // Animations d'apparition au défilement (reprises d'Elementor : fadeInUp, zoomIn…).
      const elements = document.querySelectorAll<HTMLElement>("[data-anim]");
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        const observateur = new IntersectionObserver(
          (entrees) => {
            for (const entree of entrees) {
              if (!entree.isIntersecting) continue;
              entree.target.classList.add("anim-visible");
              observateur.unobserve(entree.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        elements.forEach((el) => {
          el.classList.add("anim-prete");
          observateur.observe(el);
        });
      }
    </script>
  </body>
</html>
