---
/** Contenu provisoire, remplacé page par page pendant l'intégration. */
interface Props {
  titre: string;
}
const { titre } = Astro.props;
---

<main class="provisoire">
  <h1>{titre}</h1>
  <p>Page en cours de migration depuis WordPress.</p>
</main>

<style>
  .provisoire {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 1rem;
    padding: 160px var(--marge-mobile) 80px;
    background: var(--noir);
    color: var(--blanc);
    text-align: center;
  }

  .provisoire h1 {
    color: var(--blanc);
  }
</style>
