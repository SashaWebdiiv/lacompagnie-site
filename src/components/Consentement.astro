---
/**
 * Bannière de consentement aux cookies, reprise de l'ancienne bannière Complianz
 * (mêmes textes, mêmes boutons). Google Analytics 4 n'est chargé qu'après un accord
 * explicite : rien n'est déposé tant que la personne n'a pas cliqué sur « Tout accepter »
 * ou activé « Statistiques » dans les préférences. Fermer la bannière vaut refus.
 * Le choix est conservé 6 mois, puis redemandé.
 * Rien n'est affiché si aucun identifiant GA4 n'est configuré.
 */
import { mesure } from "../data/site";
---

{
  mesure.ga4 && (
    <div
      class="consentement"
      id="consentement"
      role="dialog"
      aria-modal="false"
      aria-labelledby="consentement-titre"
      data-ga4={mesure.ga4}
      hidden
    >
      <div class="consentement__entete">
        <p class="consentement__titre" id="consentement-titre">
          Gérer le consentement
        </p>
        <button class="consentement__fermer" type="button" data-action="refuser" aria-label="Fermer (refuse les cookies)">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 4l12 12M16 4L4 16" />
          </svg>
        </button>
      </div>

      <p class="consentement__message">
        Hey ! Notre site utilise des cookies et vous donne le contrôle sur ceux que vous souhaitez activer.
      </p>

      <div class="consentement__preferences" hidden>
        <div class="consentement__categorie">
          <span>Fonctionnel</span>
          <span class="consentement__toujours">Toujours activé</span>
        </div>
        <p class="consentement__detail">
          Nécessaire au bon fonctionnement du site (mémoriser votre choix concernant les cookies).
        </p>
        <label class="consentement__categorie">
          <span>Statistiques</span>
          <input type="checkbox" class="consentement__interrupteur" name="statistiques" />
        </label>
        <p class="consentement__detail">
          Mesure d'audience anonyme avec Google Analytics, pour savoir quelles pages sont consultées.
        </p>
      </div>

      <div class="consentement__boutons">
        <button type="button" class="consentement__bouton consentement__bouton--accepter" data-action="accepter">
          Tout accepter
        </button>
        <button type="button" class="consentement__bouton" data-action="refuser">Tout refuser</button>
        <button type="button" class="consentement__bouton" data-action="preferences" aria-expanded="false">
          Voir les préférences
        </button>
        <button type="button" class="consentement__bouton" data-action="enregistrer" hidden>
          Enregistrer les préférences
        </button>
      </div>

      <p class="consentement__liens">
        <a href="/politique-de-cookies/">Politique de cookies</a>
        <a href="/politique-de-confidentialite/">Déclaration de confidentialité</a>
      </p>
    </div>
  )
}

<script>
  const CLE = "lacompagnie-consentement";
  const DUREE_MS = 1000 * 60 * 60 * 24 * 182; // 6 mois

  type Choix = { statistiques: boolean; date: string };

  const banniere = document.querySelector<HTMLElement>("#consentement");

  const lireChoix = (): Choix | null => {
    try {
      const choix = JSON.parse(localStorage.getItem(CLE) ?? "null") as Choix | null;
      if (!choix || Date.now() - new Date(choix.date).getTime() > DUREE_MS) return null;
      return choix;
    } catch {
      return null;
    }
  };

  const supprimerCookiesGa = () => {
    const domaines = [location.hostname, `.${location.hostname.replace(/^www\./, "")}`];
    for (const nom of document.cookie.split(";").map((c) => c.split("=")[0].trim())) {
      if (!nom.startsWith("_ga")) continue;
      for (const domaine of domaines) {
        document.cookie = `${nom}=; Max-Age=0; path=/; domain=${domaine}`;
      }
      document.cookie = `${nom}=; Max-Age=0; path=/`;
    }
  };

  let gaCharge = false;
  const chargerGa = (id: string) => {
    if (gaCharge) return;
    gaCharge = true;
    const w = window as unknown as { dataLayer: unknown[]; gtag: (...args: unknown[]) => void };
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () {
      // gtag attend l'objet « arguments » lui-même.
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments);
    };
    w.gtag("js", new Date());
    // Cookies limités à 13 mois (recommandation CNIL ; Google utilise 2 ans par défaut).
    w.gtag("config", id, { cookie_expires: 60 * 60 * 24 * 395 });
    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
    document.head.appendChild(script);
  };

  if (banniere) {
    const ga4 = banniere.dataset.ga4!;
    const preferences = banniere.querySelector<HTMLElement>(".consentement__preferences")!;
    const interrupteur = banniere.querySelector<HTMLInputElement>(".consentement__interrupteur")!;
    const boutonPreferences = banniere.querySelector<HTMLButtonElement>('[data-action="preferences"]')!;
    const boutonEnregistrer = banniere.querySelector<HTMLButtonElement>('[data-action="enregistrer"]')!;

    const afficher = (voir: boolean) => {
      banniere.hidden = !voir;
      if (voir) interrupteur.checked = lireChoix()?.statistiques ?? false;
    };

    const enregistrer = (statistiques: boolean) => {
      const avant = lireChoix()?.statistiques ?? false;
      try {
        localStorage.setItem(CLE, JSON.stringify({ statistiques, date: new Date().toISOString() }));
      } catch {
        /* stockage indisponible : le choix vaut pour cette page seulement */
      }
      afficher(false);
      if (statistiques) {
        chargerGa(ga4);
      } else {
        supprimerCookiesGa();
        // Si GA tournait déjà sur la page, on recharge pour l'arrêter complètement.
        if (avant && gaCharge) location.reload();
      }
    };

    banniere.addEventListener("click", (e) => {
      const action = (e.target as HTMLElement).closest<HTMLElement>("[data-action]")?.dataset.action;
      if (action === "accepter") enregistrer(true);
      if (action === "refuser") enregistrer(false);
      if (action === "enregistrer") enregistrer(interrupteur.checked);
      if (action === "preferences") {
        const ouvrir = preferences.hidden;
        preferences.hidden = !ouvrir;
        boutonEnregistrer.hidden = !ouvrir;
        boutonPreferences.hidden = ouvrir;
        boutonPreferences.setAttribute("aria-expanded", String(ouvrir));
        if (ouvrir) interrupteur.focus();
      }
    });

    // Lien « Gérer les cookies » du pied de page.
    document.addEventListener("click", (e) => {
      if (!(e.target as HTMLElement).closest("[data-ouvrir-consentement]")) return;
      e.preventDefault();
      afficher(true);
    });

    const choix = lireChoix();
    if (choix === null) afficher(true);
    else if (choix.statistiques) chargerGa(ga4);
  }
</script>

<style>
  .consentement {
    position: fixed;
    right: 10px;
    bottom: 10px;
    z-index: 1001;
    width: 526px;
    max-width: calc(100% - 20px);
    max-height: calc(100vh - 20px);
    overflow-y: auto;
    padding: 15px 20px;
    border-radius: 12px;
    background: var(--blanc);
    box-shadow: rgba(0, 0, 0, 0.19) 0 10px 20px 0, rgba(0, 0, 0, 0.23) 0 6px 6px 0;
    color: #222;
    font-size: 12px;
    line-height: 18px;
  }

  .consentement[hidden] {
    display: none;
  }

  .consentement__entete {
    position: relative;
    display: flex;
    justify-content: center;
    min-height: 23px;
  }

  .consentement__titre {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 22.5px;
  }

  .consentement__fermer {
    position: absolute;
    top: 1px;
    right: 0;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .consentement__fermer svg {
    width: 16px;
    height: 16px;
    stroke: #222;
    stroke-width: 3.5;
  }

  .consentement__message {
    margin: 20px 0 34px;
  }

  .consentement__preferences {
    margin: -14px 0 24px;
  }

  .consentement__categorie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding: 10px 15px;
    border-radius: 8px;
    background: #f9f9f9;
    font-size: 14px;
    font-weight: 500;
  }

  .consentement__toujours {
    color: #1e73be;
    font-size: 12px;
  }

  .consentement__detail {
    margin: 6px 15px 0;
  }

  .consentement__interrupteur {
    width: 38px;
    height: 20px;
    margin: 0;
    appearance: none;
    border-radius: 20px;
    background: #ccc;
    position: relative;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .consentement__interrupteur::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--blanc);
    transition: transform 0.2s;
  }

  .consentement__interrupteur:checked {
    background: #1e73be;
  }

  .consentement__interrupteur:checked::after {
    transform: translateX(18px);
  }

  /* Largeurs de l'ancienne bannière : 153 / 153 / 160 px. */
  .consentement__boutons {
    display: grid;
    grid-template-columns: 153fr 153fr 160fr;
    gap: 10px;
  }

  .consentement__bouton {
    height: 45px;
    padding: 10px;
    border: 1px solid #f2f2f2;
    border-radius: 35px;
    background: #f9f9f9;
    color: #222;
    font: 500 15px/20px var(--fonte-texte);
    cursor: pointer;
  }

  .consentement__bouton[hidden] {
    display: none;
  }

  .consentement__bouton[data-action="preferences"],
  .consentement__bouton[data-action="enregistrer"] {
    color: #333;
  }

  .consentement__bouton--accepter {
    border-color: #1e73be;
    background: #1e73be;
    color: var(--blanc);
    font-family: var(--fonte-titre);
  }

  .consentement__bouton:hover {
    filter: brightness(0.95);
  }

  .consentement__liens {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 10px 0 0;
  }

  .consentement__liens a {
    color: #1e73be;
    text-decoration: underline;
  }

  @media (max-width: 767px) {
    .consentement {
      right: 0;
      bottom: 0;
      width: 100%;
      max-width: none;
      border-radius: 12px 12px 0 0;
    }

    .consentement__titre {
      visibility: hidden;
    }

    .consentement__message {
      margin: 20px 0 34px;
    }

    .consentement__boutons {
      grid-template-columns: 1fr;
    }
  }
</style>
